CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024
CONFIG_COMPILER_CXX_RTTI=y

CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Log level: default INFO (3), compile-time maximum DEBUG (4).
#
# CONFIG_LOG_MAXIMUM_LEVEL controls which ESP_LOGx macros are compiled into
# the binary. Set to 4 (DEBUG) so that ESP_LOGD() calls are compiled in and
# can be selectively enabled per-tag at runtime via esp_log_level_set().
#
# The default runtime level remains INFO (3), so only tags explicitly set
# to DEBUG will produce debug output. This avoids global debug noise while
# allowing targeted diagnostics for AI SDK and protocol modules.
#
# Stack safety: main task stack is 12288 bytes (see below), providing
# sufficient headroom for occasional debug log calls in deep call chains.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL=4

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# adjusted from 8192 to 12288
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# These entries are copied from ESP-HI (ESP32C3) to reduce memory usage
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Fix ML307 FIFO Overflow
CONFIG_UART_ISR_IN_IRAM=y

# Fix ESP_SSL error
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

# LVGL 9.2.2

CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_ASSERT_STYLE=y

# Use compressed font
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=n
CONFIG_LV_USE_FONT_PLACEHOLDER=n
CONFIG_LV_USE_LODEPNG=y

# Disable extra widgets to save flash size
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# Disable wake word detection by default
# Device will auto-start listening after 60 seconds without requiring a wake word
CONFIG_WAKE_WORD_DISABLED=y

# Globally force AI SDK protocol for cloud ASR path.
# This bypasses OTA-driven MQTT/WebSocket selection in Application::InitializeProtocol().
CONFIG_USE_AI_SDK_PROTOCOL=y

# AI SDK audio mode: SDK auto-manage audio (Mode A).
# SDK internally manages microphone recording (AudioInput) and TTS playback (TtsPlayer).
# Set to 'n' to use AudioService with Opus encode/decode pipeline (Mode B).
CONFIG_AI_SDK_AUTO_AUDIO=y

# Disable AFE audio noise reduction processor.
# In AI SDK mode, AudioService is not used and the AFE processor would waste
# CPU cycles and PSRAM. The Kconfig default is 'y' for ESP32-S3 + SPIRAM,
# so we explicitly disable it here.
CONFIG_USE_AUDIO_PROCESSOR=n

# Enforce strict TLS verification defaults.
# Keep insecure mode and server-cert skipping disabled.
CONFIG_ESP_TLS_INSECURE=n
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=n

# ===========================================================================
# TCP/IP and TLS Tuning for WebSocket Audio Streaming
# ===========================================================================
#
# AI SDK streams PCM audio over WSS in real time.
# Each audio chunk = 5120 bytes (160ms @ 16kHz/16-bit/mono).
# After adding WebSocket frame header (8B) and TLS record overhead (~29B),
# the per-chunk TCP payload is about 5186 bytes.
#
# Default lwIP TCP send buffer (5760B) barely fits one chunk with no
# headroom for in-flight data awaiting ACK, causing TCP send buffer
# exhaustion and transport_poll_write errors after ~14 chunks.
# Default mbedTLS output content length (4096B) is smaller than the
# chunk payload (5128B), forcing every chunk into two TLS records.
# ---------------------------------------------------------------------------

# TCP send buffer: 16KB (default 5760)
# Buffers ~3 audio chunks while waiting for server ACKs.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384

# TCP receive window: 16KB (default 5760)
# Improves throughput for server JSON responses (mid_result, fin_result).
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# TLS output record content length: 8KB (default 4096)
# Fits each audio chunk (5128B) in a single TLS record.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=8192

# TCP receive mailbox size per socket (default 6).
# Recommended formula from ESP-IDF: TCP_WND / TCP_MSS + 2.
# With TCP_WND=16384 and TCP_MSS=1440: 16384/1440 + 2 = 14.
# Too-small mailbox causes packet drops under high throughput.
CONFIG_LWIP_TCP_RECVMBOX_SIZE=14

# Allow WiFi/lwIP buffers to be allocated from PSRAM.
# Without this, all TCP buffers (16KB send + 16KB recv per connection)
# are allocated from internal SRAM (~200KB free), causing heap
# exhaustion and crashes (Guru Meditation / LoadProhibited).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

