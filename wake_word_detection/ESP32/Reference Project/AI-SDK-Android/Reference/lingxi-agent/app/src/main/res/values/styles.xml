<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="MyTabTextAppearance" parent="TextAppearance.Design.Tab"><!-- 设置为false以避免文本全部大写 -->
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_black</item>
        <item name="android:textAllCaps">false</item>

    </style>

    <style name="AgentTabTextAppearance" parent="TextAppearance.Design.Tab"><!-- 设置为false以避免文本全部大写 -->
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/account_text_primary</item>
        <item name="android:textAllCaps">false</item>

    </style>

    <style name="FullScreenDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="ColorPickerDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
    </style>

    <style name="StyleSelectionDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/StyleSelectionAnimation</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="StyleSelectionAnimation">
        <item name="android:windowEnterAnimation">@android:anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@android:anim/slide_out_right</item>
    </style>

    <style name="CustomTextSize">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="CustomDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- 同声传译对话框样式 -->
    <style name="DialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
    <style name="BottomSheetDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation.SlideUp</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@android:anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@android:anim/slide_out_right</item>
    </style>

    <!-- 创建底部弹出动画 -->
    <style name="BottomSheetAnimation.SlideUp">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!-- 弹窗菜单动画 -->
    <style name="PopupMenuAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_menu_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_menu_exit</item>
    </style>

    <style name="like_toast_dialog_style">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="PopupAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
    <style name="Theme.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 1. 基础透明设置 -->
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="colorAccent">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <!-- 2. 关键：允许窗口绘制系统栏背景 (必须为 true，否则下面的颜色设置无效) -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- 3. 设置状态栏和导航栏为完全透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 4. 解决 Android 10+ 强制对比度导致的“假透明” (白色遮罩) -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <!-- 5. 窗口特性 -->
        <item name="android:windowIsTranslucent">true</item> <!-- 保持半透明窗口特性 -->
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- 6. 适配全面屏/刘海屏 (防止边缘黑条) -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- 7. 动画 (可选，保持原有) -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>


    </style>

    <style name="TitleText">
        <item name="android:textSize">@dimen/text_title_size</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="SubtitleText">
        <item name="android:textSize">@dimen/text_subtitle_size</item>
        <item name="android:textColor">@color/text_subtitle</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:maxWidth">300dp</item>
    </style>

    <style name="RecommendationTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:layout_marginBottom">15dp</item>
    </style>

    <style name="TagStyle">
        <item name="android:background">@drawable/tag_background</item>
        <item name="android:paddingVertical" tools:targetApi="26">@dimen/tag_padding</item>
        <item name="android:paddingHorizontal" tools:targetApi="26">@dimen/tag_padding_horizontal</item>
        <item name="android:textSize">@dimen/tag_text_size</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:layout_margin">@dimen/tag_spacing</item>
    </style>

    <style name="RecentTitle">
        <item name="android:textSize">@dimen/recent_title_size</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">15dp</item>
    </style>

    <style name="RecentItemTitle">
        <item name="android:textSize">@dimen/recent_text_title</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginBottom">3dp</item>
    </style>

    <style name="RecentItemTime">
        <item name="android:textSize">@dimen/recent_text_time</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="GenerateButton">
        <item name="android:background">@drawable/generate_btn_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/generate_btn_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">@dimen/generate_btn_padding</item>
        <item name="android:layout_margin">@dimen/generate_btn_margin</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextActionItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">@dimen/dp_16</item>
        <item name="android:layout_marginTop">@dimen/dp_16</item>
        <item name="android:layout_marginLeft">@dimen/dp_24</item>
        <item name="android:textColor">@color/figma_text_primary</item>
        <item name="android:textSize">@dimen/font_14</item>
    </style>

    <style name="TextSelectItem">
        <item name="android:layout_width">@dimen/dp_50</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">@dimen/dp_4</item>
        <item name="android:layout_marginTop">@dimen/dp_16</item>
        <item name="android:layout_marginBottom">@dimen/dp_10</item>
        <item name="android:layout_marginLeft">@dimen/dp_20</item>
        <item name="android:textColor">@color/figma_text_primary</item>
        <item name="android:textSize">@dimen/font_12</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="HintDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0</item>
    </style>

    <style name="EditTextMaxLength">
        <item name="android:maxLength">20</item>
    </style>

    <!-- 图片预览全屏主题 -->
    <style name="ImagePreviewTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="HomeFontStyle">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 全屏透明主题 - 用于WaitingReplyDialogActivity -->
    <style name="Theme.FullScreenTransparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.TransparentActivity" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

</resources>