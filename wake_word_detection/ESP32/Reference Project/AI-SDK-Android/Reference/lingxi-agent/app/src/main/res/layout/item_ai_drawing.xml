<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:id="@+id/root_view"
    android:layout_marginTop="@dimen/dp_16"
    android:layout_marginHorizontal="@dimen/dp_16">

    <include layout="@layout/lingxi_base_radio_layout"
        android:id="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:id="@+id/ll_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/radio_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_f7_r16"
        android:paddingVertical="@dimen/dp_10"
        android:paddingLeft="@dimen/dp_16"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/content_generated_images_2"
            android:textSize="@dimen/font_16"
            android:textColor="@color/text_hint_color"
            android:layout_marginBottom="@dimen/dp_10"
            />

        <RelativeLayout
            android:id="@+id/rl_container"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_320">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_iv_drawing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="@dimen/dp_8"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <ImageView
                    android:id="@+id/iv_drawing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="false"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:id="@+id/rl_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <!-- 进度文本显示 -->
                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_zero_percent"
                    android:textSize="@dimen/font_16"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_actions_drawing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="@dimen/dp_10"
                android:visibility="visible"
                android:layout_alignParentBottom="true"
                android:gravity="center_vertical"
                >
                <RelativeLayout
                    android:id="@+id/iv_chat_draw_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_1e40_r16">

                    <ImageView
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                         android:layout_margin="@dimen/dp_6"
                        android:background="@drawable/draw_download"
                        />
                </RelativeLayout>

                <ImageView
                    android:id="@+id/iv_chat_draw_continue"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/drawing_edit"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:visibility="gone"
                    />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:id="@+id/iv_chat_refresh"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/drawing_refresh"
                    />

<!--                <TextView-->
<!--                    android:id="@+id/iv_chat_draw_continue"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="@string/btn_continue_edit"-->
<!--                    android:textColor="@color/white"-->
<!--                    android:paddingLeft="@dimen/dp_13"-->
<!--                    android:paddingRight="@dimen/dp_13"-->
<!--                    android:paddingTop="@dimen/dp_5"-->
<!--                    android:paddingBottom="@dimen/dp_5"-->
<!--                    android:gravity="center"-->
<!--                    android:background="@drawable/bg_1e40_r16"-->
<!--                    />-->
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/dp_10"
            android:visibility="gone"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:background="#E0E0E0"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/dp_10"
                >
                <ImageView
                    android:id="@+id/iv_chat_copy"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@mipmap/chat_copy"
                    />

                <ImageView
                    android:id="@+id/iv_chat_play"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:src="@mipmap/chat_play"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:visibility="gone"
                    />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                </LinearLayout>
<!--                <ImageView-->
<!--                    android:id="@+id/iv_chat_refresh"-->
<!--                    android:layout_width="@dimen/dp_28"-->
<!--                    android:layout_height="@dimen/dp_28"-->
<!--                    android:background="@mipmap/chat_refresh"-->
<!--                    android:layout_marginLeft="@dimen/dp_10"-->
<!--                    />-->
                <ImageView
                    android:id="@+id/iv_chat_export"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@mipmap/chat_export"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:visibility="gone"
                    />
            </LinearLayout>


        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/vw_empty"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/ll_content"
        app:layout_constraintBottom_toBottomOf="@+id/ll_content"
        app:layout_constraintStart_toStartOf="@+id/ll_content"
        app:layout_constraintEnd_toEndOf="@+id/ll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>
