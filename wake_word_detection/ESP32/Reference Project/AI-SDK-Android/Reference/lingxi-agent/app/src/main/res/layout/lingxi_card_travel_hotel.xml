<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_14"
    android:layout_marginRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_10"
    android:background="@drawable/bg_message_received"
    android:orientation="horizontal">
    <include layout="@layout/lingxi_base_radio_layout"
        android:id="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        app:layout_constraintStart_toEndOf="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/rvHotelItems"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/dp_12"
        android:paddingRight="@dimen/dp_12"
        android:clipToPadding="false"
        android:visibility="visible"
        android:paddingBottom="@dimen/dp_10" />
    <View
        android:id="@+id/vw_empty"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/rvHotelItems"
        app:layout_constraintBottom_toBottomOf="@+id/rvHotelItems"
        app:layout_constraintStart_toStartOf="@+id/rvHotelItems"
        app:layout_constraintEnd_toEndOf="@+id/rvHotelItems"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>