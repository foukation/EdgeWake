<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 顶部导航栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_16">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_back"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </RelativeLayout>

    <!-- 内容区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <!-- 描述文本 -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_shanghai_night_blur"
                android:textSize="@dimen/font_16"
                android:textColor="#333333"
                android:lineSpacingExtra="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_16" />

            <!-- 状态标签 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/dp_16">

                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/ic_check_circle_green"
                    android:layout_marginEnd="@dimen/dp_8" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_saved_to_gallery"
                    android:textSize="@dimen/font_14"
                    android:textColor="#52C41A" />

            </LinearLayout>

            <!-- 生成的图片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_generated_image"
                android:layout_width="@dimen/dp_200"
                android:layout_height="@dimen/dp_356"
                android:layout_marginBottom="@dimen/dp_24"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/iv_generated_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image_placeholder" />

                <!-- 下载和继续编辑按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:background="@drawable/gradient_black_transparent"
                    android:padding="@dimen/dp_12">

                    <LinearLayout
                        android:id="@+id/ll_download"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_button_rounded_white_alpha"
                        android:padding="@dimen/dp_8">

                        <ImageView
                            android:layout_width="@dimen/dp_16"
                            android:layout_height="@dimen/dp_16"
                            android:src="@drawable/ic_download"
                            android:tint="@color/white"
                            android:layout_marginEnd="@dimen/dp_4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_download"
                            android:textSize="@dimen/font_12"
                            android:textColor="@color/white" />

                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/dp_8"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:id="@+id/ll_continue_edit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_button_rounded_white_alpha"
                        android:padding="@dimen/dp_8">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_continue_edit"
                            android:textSize="@dimen/font_12"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 提示文本 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/content_generated_images_2"
                android:textSize="@dimen/font_14"
                android:textColor="#666666"
                android:layout_marginBottom="@dimen/dp_16" />

            <!-- 底部操作按钮 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_sound"
                   android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:src="@drawable/ic_volume"
                    android:padding="@dimen/dp_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="@dimen/dp_16" />

                <ImageView
                    android:id="@+id/iv_bookmark"
                   android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:src="@drawable/ic_bookmark_outline"
                    android:padding="@dimen/dp_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="@dimen/dp_16" />

                <ImageView
                    android:id="@+id/iv_refresh"
                   android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:src="@drawable/ic_refresh"
                    android:padding="@dimen/dp_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="@dimen/dp_16" />

                <ImageView
                    android:id="@+id/iv_more"
                   android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:src="@drawable/ic_more_horiz"
                    android:padding="@dimen/dp_4"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:elevation="@dimen/dp_4">

        <!-- AI 写作 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/dp_8">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_write"
                android:layout_marginBottom="@dimen/dp_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_ai_writing"
                android:textSize="@dimen/font_12"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- AI 翻译 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/dp_8">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_translate"
                android:layout_marginBottom="@dimen/dp_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_ai_translation"
                android:textSize="@dimen/font_12"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- PPT生成 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/dp_8">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_ppt"
                android:layout_marginBottom="@dimen/dp_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_ppt_generation"
                android:textSize="@dimen/font_12"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- AI 绘画 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/dp_8">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_drawing"
                android:tint="@color/primary"
                android:layout_marginBottom="@dimen/dp_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_ai_drawing_2"
                android:textSize="@dimen/font_12"
                android:textColor="@color/primary" />

        </LinearLayout>

    </LinearLayout>

    <!-- 底部分享栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_send_message_ellipsis"
            android:textSize="@dimen/font_14"
            android:textColor="#999999"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_voice"
            android:layout_marginEnd="@dimen/dp_20" />

        <ImageView
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_add_circle"
            android:layout_marginEnd="@dimen/dp_20" />

        <TextView
            android:id="@+id/tv_share"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:gravity="center"
            android:text="@string/btn_share"
            android:textSize="@dimen/font_14"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_rounded_primary" />

    </LinearLayout>

</LinearLayout>