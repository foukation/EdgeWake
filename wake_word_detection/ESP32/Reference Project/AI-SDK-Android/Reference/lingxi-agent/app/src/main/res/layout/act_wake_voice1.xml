<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false">


    <!-- 底部面板 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/dp_2"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/ll_touch"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_20"
            android:paddingTop="@dimen/dp_8"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical">
            <View
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_4"

                android:background="@drawable/line_wake"/>
        </LinearLayout>


        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_touch">

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:elevation="@dimen/dp_8">
        <LinearLayout
            android:id="@+id/ll_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent"

            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- 分享时，底部占位元素 -->
            <Space
                android:id="@+id/ll_placeholder"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:visibility="gone" />

            <include
                android:id="@+id/ll_wake_main"
                layout="@layout/layout_super_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

        </LinearLayout>
        <com.fxzs.lingxiagent.view.common.AutoRecordView
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            android:background="@color/color_1E1E1E"
            android:id="@+id/voiceWakeRecordView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:elevation="@dimen/dp_10"
            android:gravity="bottom" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
