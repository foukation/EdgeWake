<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 标题栏 -->
    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingHorizontal="@dimen/dp_16">

        <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
               />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/title_si_conversation_mode"
                android:textSize="@dimen/font_16"
                android:textColor="@color/text_primary"
                android:textStyle="normal"/>

        <ImageView
                android:id="@+id/iv_export"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_share"
                android:contentDescription="导出JSON"
            android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/dp_4"/>

        <ImageView
                android:id="@+id/iv_flip"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
                android:src="@mipmap/ic_translate_change_view"
                android:contentDescription="翻转视图"
                android:background="?attr/selectableItemBackgroundBorderless"
               />

    </RelativeLayout>

    <!-- 说话人A区域 - 上半屏（卡片样式） -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@android:color/transparent">

        <!-- 外边距容器 -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/dp_12">

            <!-- 卡片容器 -->
            <LinearLayout
                    android:id="@+id/top_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dialog_card_blue"
                    android:paddingHorizontal="@dimen/dp_7">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <!-- A方消息列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_messages_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:clipToPadding="false"

                        />

                    <!-- 提示文字（保持ID，不显示） -->
                    <TextView
                        android:id="@+id/tv_hint_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/label_tap_mic_to_start"
                        android:textSize="@dimen/font_14"
                        android:textColor="@color/figma_text_primary"
                        android:layout_centerInParent="true"
                        android:visibility="visible"/>

                </RelativeLayout>

                <!-- 底部控制栏 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="@dimen/dp_8">

                    <!-- 播放按钮容器：喇叭图标和动画按钮叠加显示 -->
                    <FrameLayout
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24">
                        
                        <!-- 喇叭图标（默认显示） -->
                        <ImageView
                            android:id="@+id/iv_play_a1"
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@drawable/ic_volume"
                            android:clickable="true"
                            android:focusable="true"/>
                        
                        <!-- 动画按钮（播放时显示） -->
                        <ImageView
                            android:id="@+id/iv_play_a"
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@drawable/ic_play"
                            android:tint="@color/primary_blue"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|right"
                        >
                    <LinearLayout
                        android:id="@+id/ll_language_a"
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginRight="@dimen/dp_5"
                        >


                        <TextView
                            android:id="@+id/tv_language_a"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:text="@string/label_english"
                            android:textSize="@dimen/font_12"
                            android:textColor="@color/primary_blue"/>

                        <TextView
                            android:id="@+id/tv_language_a2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:text="@string/label_english_us"
                            android:textSize="@dimen/font_12"
                            android:textColor="@color/figma_text_hint"
                            android:visibility="gone"
                            />

                        <ImageView
                            android:layout_width="@dimen/dp_16"
                            android:layout_height="@dimen/dp_16"
                            android:background="@drawable/ic_translate_down_arrow"
                            />
                    </LinearLayout>



                    </LinearLayout>

                    <FrameLayout
                            android:id="@+id/mic_container_a"
                            android:layout_width="@dimen/dp_64"
                            android:layout_height="@dimen/dp_64"
                            android:layout_marginStart="@dimen/dp_12">

                        <ImageView
                                android:id="@+id/iv_mic_mask_a"
                                android:layout_width="@dimen/dp_64"
                                android:layout_height="@dimen/dp_64"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_translate_mic_mask"
                                android:visibility="gone" />

                        <ImageView
                                android:id="@+id/btn_microphone_a"
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:layout_marginTop="@dimen/dp_3"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_translate_mic"
                                android:clickable="true"
                                android:focusable="true" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 中间分隔线（视觉留白） -->
    <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_12" />

    <!-- 说话人B区域 - 下半屏（卡片样式） -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@android:color/transparent">

        <!-- 外边距容器 -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_12">

            <!-- 卡片容器 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dialog_card_blue"
                android:paddingHorizontal="@dimen/dp_7">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- B方消息列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_messages_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:clipToPadding="false" />

                    <!-- 提示文字（保持ID，不显示） -->
                    <TextView
                        android:id="@+id/tv_hint_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/msg_click_mic_to_start"
                        android:textSize="@dimen/font_14"
                        android:textColor="@color/figma_text_primary"
                        android:visibility="visible" />

                </RelativeLayout>

                <!-- 底部控制栏 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="@dimen/dp_8">

                    <!-- 播放按钮容器：喇叭图标和动画按钮叠加显示 -->
                    <FrameLayout
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24">
                        
                        <!-- 喇叭图标（默认显示） -->
                        <ImageView
                            android:id="@+id/iv_play_b1"
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@drawable/ic_volume"
                            android:clickable="true"
                            android:focusable="true"/>
                        
                        <!-- 动画按钮（播放时显示） -->
                        <ImageView
                            android:id="@+id/iv_play_b"
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@drawable/ic_play"
                            android:tint="@color/primary_blue"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"/>
                    </FrameLayout>



                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|right"
                        >
                        <LinearLayout
                            android:id="@+id/ll_language_b"
                            android:layout_width="wrap_content"

                            android:gravity="right"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginRight="@dimen/dp_5"
                            >


                            <TextView
                                android:id="@+id/tv_language_b"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:text="@string/label_chinese"
                                android:textSize="@dimen/font_12"
                                android:textColor="@color/primary_blue"/>

                            <TextView
                                android:id="@+id/tv_language_b2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:text="@string/label_english_us"
                                android:textSize="@dimen/font_12"
                                android:textColor="@color/figma_text_hint"
                                android:visibility="gone"/>

                            <ImageView
                                android:layout_width="@dimen/dp_16"
                                android:layout_height="@dimen/dp_16"
                                android:background="@drawable/ic_translate_down_arrow"
                                />
                        </LinearLayout>


                    </LinearLayout>

                    <FrameLayout
                            android:id="@+id/mic_container_b"
                            android:layout_width="@dimen/dp_64"
                            android:layout_height="@dimen/dp_64"
                            android:layout_marginStart="@dimen/dp_12">

                        <ImageView
                                android:id="@+id/iv_mic_mask_b"
                                android:layout_width="@dimen/dp_64"
                                android:layout_height="@dimen/dp_64"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_translate_mic_mask"
                                android:visibility="gone" />

                        <ImageView
                                android:id="@+id/btn_microphone_b"
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:layout_marginTop="@dimen/dp_3"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_translate_mic"
                                android:clickable="true"
                                android:focusable="true" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>