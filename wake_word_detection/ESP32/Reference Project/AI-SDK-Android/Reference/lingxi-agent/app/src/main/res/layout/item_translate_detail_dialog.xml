<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginBottom="@dimen/dp_8"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginRight="@dimen/dp_16"
    >
 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:background="@drawable/bg_f7_r16"
     android:padding="@dimen/dp_16"
     >
     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="horizontal">

         <TextView
             android:id="@+id/tv_source_language"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:layout_height="wrap_content"
             android:text="@string/label_chinese"
             android:textColor="@color/text_555"
             android:textSize="@dimen/font_10"
             />
         <ImageView
             android:id="@+id/tv_source_copy"
             android:layout_width="@dimen/dp_16"
             android:layout_height="@dimen/dp_16"
             android:layout_gravity="center"
             android:src="@drawable/ic_copy_modern" />

     </LinearLayout>

     <TextView
         android:id="@+id/tv_source"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="@dimen/dp_10"
         android:text="@string/label_placeholder"
         android:textColor="@color/figma_text_primary"
         android:textSize="@dimen/font_12"
         />

     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="@dimen/dp_1"
         android:background="#E5E5E5"
         android:layout_marginVertical="@dimen/dp_16"
         />
     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="horizontal">
     <TextView
         android:id="@+id/tv_target_language"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_height="wrap_content"
         android:text="@string/label_english"
         android:textColor="@color/text_555"
         android:textSize="@dimen/font_10"
         />
     <ImageView
         android:id="@+id/tv_target_copy"
         android:layout_width="@dimen/dp_16"
         android:layout_height="@dimen/dp_16"
         android:layout_gravity="center"
         android:src="@drawable/ic_copy_modern" />

 </LinearLayout>

    <TextView
        android:id="@+id/tv_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/label_placeholder"
        android:textColor="@color/figma_primary_blue"
        android:textSize="@dimen/font_12"
        />
 </LinearLayout>
</LinearLayout>