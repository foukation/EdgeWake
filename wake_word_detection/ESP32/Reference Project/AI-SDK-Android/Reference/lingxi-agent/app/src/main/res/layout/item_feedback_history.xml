<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_feedback_history_item"
    android:padding="@dimen/dp_20"
    android:layout_marginBottom="@dimen/dp_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- 反馈内容 -->
    <TextView
        android:id="@+id/tv_feedback_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sample_mouse_click_issue"
        android:textColor="#1F2937"
        android:textSize="@dimen/font_16"
        android:lineSpacingExtra="@dimen/dp_6"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.01"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- 图片预览区域 -->
    <HorizontalScrollView
        android:id="@+id/layout_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_image1"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginEnd="@dimen/dp_12"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_feedback_image"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_image2"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginEnd="@dimen/dp_12"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_feedback_image"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_image3"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginEnd="@dimen/dp_12"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_feedback_image"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_image4"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_feedback_image"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 时间 -->
    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/label_date_2025_4_11"
        android:textColor="#9CA3AF"
        android:textSize="@dimen/font_14"
        android:fontFamily="sans-serif" />

</LinearLayout>