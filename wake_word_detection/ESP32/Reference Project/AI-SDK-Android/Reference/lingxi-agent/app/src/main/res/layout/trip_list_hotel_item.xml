<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_4">

    <!-- 分类标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/category_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_20"
            android:layout_weight="1"
            android:drawableLeft="@drawable/shape_l0_r2_c1587ff"
            android:drawablePadding="@dimen/dp_4"
            android:textColor="@color/black"
            android:textSize="@dimen/font_14"
            tools:text="性价比之选" />

        <TextView
            android:id="@+id/more_button"
            android:layout_width="@dimen/dp_44"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_47"
            android:text="@string/label_more_arrow"
            android:textColor="#7A7A7A"
            android:textSize="@dimen/font_12" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_4"
        android:background="@drawable/shape_r10_cf5f5f7"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/trip_item_img"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:scaleType="centerCrop"
            android:src="@drawable/rest" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_80"
            android:layout_marginStart="@dimen/dp_neg_20"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_weight="1"
            android:background="@color/tag_background"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_10"
            android:paddingTop="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_6"
            tools:ignore="RtlSymmetry">

            <TextView
                android:id="@+id/trip_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/font_15"
                android:textStyle="bold"
                tools:text="北京天坛东门亚朵酒店（北京天坛公园店）" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/trip_item_score"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_15"
                    android:background="@drawable/item_score_rectangle"
                    android:gravity="center"
                    android:text="@string/label_rating_4_7"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_11" />

                <TextView
                    android:id="@+id/trip_item_tag_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:background="@drawable/item_hotel_tag_rectangle"
                    android:paddingStart="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_4"
                    android:text="@string/label_free_car_wash"
                    android:textColor="@color/color_99000000"
                    android:textSize="@dimen/font_11" />

                <!--                <TextView-->
                <!--                    android:id="@+id/trip_item_tag_two"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:background="@drawable/item_hotel_tag_rectangle"-->
                <!--                    android:layout_marginStart="@dimen/dp_4"-->
                <!--                    android:paddingStart="@dimen/dp_4"-->
                <!--                    android:paddingEnd="@dimen/dp_4"-->
                <!--                    android:text="@string/label_laundry"-->
                <!--                    android:textColor="#ff288dde"-->
                <!--                    android:textSize="8sp" />-->

                <!--                <TextView-->
                <!--                    android:id="@+id/trip_item_tag_three"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:background="@drawable/item_hotel_tag_rectangle"-->
                <!--                    android:layout_marginStart="@dimen/dp_4"-->
                <!--                    android:paddingStart="@dimen/dp_4"-->
                <!--                    android:paddingEnd="@dimen/dp_4"-->
                <!--                    android:text="@string/label_gym"-->
                <!--                    android:textColor="#ff288dde"-->
                <!--                    android:textSize="8sp" />-->
            </LinearLayout>

            <TextView
                android:id="@+id/trip_item_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/label_restaurant_address"
                android:textColor="#ff999999"
                android:textSize="@dimen/font_12" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>