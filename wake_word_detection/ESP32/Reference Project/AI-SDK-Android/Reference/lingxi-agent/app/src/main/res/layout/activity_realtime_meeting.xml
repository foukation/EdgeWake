        <androidx.cardview.widget.CardView
            android:id="@+id/myCardView"
            android:layout_width="@dimen/dp_320"
            android:layout_height="@dimen/dp_422"
            android:layout_gravity="center_horizontal"

            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            app:cardCornerRadius="@dimen/dp_16"
            app:cardElevation="@dimen/dp_8"
            app:cardUseCompatPadding="true"
            android:layout_centerInParent="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.5">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@mipmap/login_bg2"
                android:scaleType="fitStart"
                android:adjustViewBounds="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:visibility="visible"
                android:orientation="vertical">



                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_date_meeting"
                    android:textColor="@color/figma_text_primary"
                    android:textSize="@dimen/font_16"
                    android:fontWeight="500"
                    android:fontFamily="sans-serif-medium"
                    android:lineHeight="@dimen/dp_24"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center_horizontal" />
                <RelativeLayout
                    android:layout_width="@dimen/dp_270"
                    android:layout_height="@dimen/dp_270"
                    android:layout_gravity="center_horizontal"

                    android:layout_marginBottom="@dimen/dp_90"
                    >



                <ImageView

                    android:id="@+id/iv_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>

<!--                    <com.fxzs.lingxiagent.view.widget.CustomCircleView-->
<!--                        android:id="@+id/circleView"-->
<!--                        android:layout_width="@dimen/dp_270"-->
<!--                        android:layout_height="@dimen/dp_270"-->
<!--                        android:visibility="visible"-->
<!--                        />-->
                    <com.fxzs.lingxiagent.view.widget.WaveView
                        android:id="@+id/circleView"
                        android:layout_width="@dimen/dp_270"
                        android:layout_height="@dimen/dp_270"
                        android:visibility="visible"
                        />
                    <ImageView
                        android:id="@+id/head"
                        android:layout_width="@dimen/dp_77"
                        android:layout_height="@dimen/dp_77"
                        android:src="@mipmap/ic_app_logo"
                        android:layout_centerInParent="true"
                        android:visibility="visible"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/head"
                        android:layout_marginTop="@dimen/dp_10"
                        android:layout_centerHorizontal="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_status_text"
                            android:layout_width="@dimen/dp_120"
                            android:layout_height="@dimen/dp_24"
                            android:text="@string/msg_lingxi_recording"
                            android:textColor="@color/text_999"
                            android:textSize="@dimen/font_14"
                            android:fontWeight="400"
                            android:fontFamily="sans-serif-medium"
                            android:lineHeight="@dimen/dp_24"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal" />



                        <TextView
                            android:id="@+id/tv_recording_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_zero_time"
                            android:textColor="@color/figma_text_primary"
                            android:textSize="@dimen/font_20"
                            android:fontWeight="500"
                            android:fontFamily="sans-serif-medium"
                            android:lineHeight="@dimen/dp_24"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:visibility="visible" />

                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/dp_44"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:baselineAligned="false">

        <!-- Pause Button - Figma Design: Frame 858 -->
        <!-- width: 163px; height: 48px; border: 1px #E0E0E0; border-radius: 12px; gap: 8px -->
        <FrameLayout
            android:id="@+id/btn_pause_meeting"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@drawable/bg_stoke_e0_r16">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16">

                <!-- Pause Icon 16x16px -->
                <ImageView
                    android:id="@+id/iv_button"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:src="@drawable/ic_pause_16"
                    android:contentDescription="暂停图标" />

                <!-- Text: PingFang SC 14sp 400weight #1E1E1E -->
                <TextView
                    android:id="@+id/tv_pause_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_pause_meeting"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_14"
                    android:fontWeight="400"
                    android:lineHeight="19.6sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- End Meeting Button - Figma Design: Frame 857 -->
        <!-- width: 164px; height: 48px; background: #1C77FF; border-radius: 12px -->
        <FrameLayout
            android:id="@+id/btn_stop_recording"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@drawable/bg_button_primary">

            <!-- Text: PingFang SC 14sp 500weight #FFFFFF -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontWeight="500"
                android:lineHeight="@dimen/dp_20"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10"
                android:text="@string/btn_end_meeting"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/font_14" />

        </FrameLayout>

    </LinearLayout>

    <!-- Recording Time Display (Hidden by default) -->

</LinearLayout>