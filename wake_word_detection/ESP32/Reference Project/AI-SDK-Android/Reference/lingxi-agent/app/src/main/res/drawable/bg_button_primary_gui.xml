<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 渐变边框（底层，稍微大一点） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFE4D3FA"
                android:endColor="#FFD0ECFD"
                android:angle="90" />
            <corners android:radius="25dp" />
        </shape>
    </item>

    <!-- 背景填充（上层，内边距形成边框效果） -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFF5F5FE" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>