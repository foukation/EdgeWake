<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_party_item"
            android:orientation="horizontal"
            android:padding="@dimen/dp_10">

            <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="@dimen/dp_85"
                android:layout_height="@dimen/dp_85"
                android:layout_marginTop="@dimen/dp_5"
                app:cardCornerRadius="@dimen/dp_8"
                app:cardElevation="@dimen/dp_4">

                <ImageView
                    android:id="@+id/trip_item_img"
                    android:layout_width="@dimen/dp_85"
                    android:layout_height="@dimen/dp_85"
                    android:scaleType="centerCrop" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_12"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/trip_item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_restaurant_name"
                    android:textColor="#ff323232"
                    android:textSize="@dimen/font_16"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/trip_item_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_8"
                        android:background="@drawable/bg_card_party_score"
                        android:gravity="center"
                        android:padding="@dimen/dp_3"
                        android:text="@string/label_rating_4_9"
                        android:textColor="#fff"
                        android:textSize="@dimen/font_11" />

                    <TextView
                        android:id="@+id/trip_item_bus_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/content_service_hours"
                        android:textColor="#ff323232"
                        android:textSize="@dimen/font_12" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/trip_item_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_restaurant_address"
                        android:textColor="#ff323232"
                        android:textSize="@dimen/font_12" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/trip_item_tag1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp_8"
                        android:background="@drawable/bg_card_party_target"
                        android:paddingHorizontal="@dimen/dp_4"
                        android:text=""
                        android:textColor="#ff288dde"
                        android:textSize="@dimen/font_11" />

                    <TextView
                        android:id="@+id/trip_item_tag2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp_8"
                        android:background="@drawable/bg_card_party_target"
                        android:paddingHorizontal="@dimen/dp_4"
                        android:text=""
                        android:textColor="#ff288dde"
                        android:textSize="@dimen/font_11" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/trip_item_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_5"
            android:background="#F5F6F7"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:visibility="visible" />

    </LinearLayout>
</LinearLayout>