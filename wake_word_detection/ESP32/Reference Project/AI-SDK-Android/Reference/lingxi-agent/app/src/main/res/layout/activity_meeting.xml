<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="@color/white"
        android:elevation="@dimen/dp_1">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:padding="@dimen/dp_12"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_ai_realtime_meeting"
            android:textColor="#1F2937"
            android:textSize="@dimen/font_18"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Tab Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:orientation="horizontal"
        android:background="@color/white">

        <TextView
            android:id="@+id/tab_realtime"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_ai_realtime_meeting"
            android:textColor="#1F2937"
            android:textSize="@dimen/font_16"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_audio_file"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_av_transcription"
            android:textColor="#6B7280"
            android:textSize="@dimen/font_16"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Tab indicator -->
    <View
        android:id="@+id/tab_indicator"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_3"
        android:background="#3B82F6"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/dp_60" />

    <!-- Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Normal Content -->
        <ScrollView
            android:id="@+id/scroll_normal_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_20">

                <!-- Meeting Title Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:padding="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:elevation="@dimen/dp_2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_meeting_name"
                        android:textColor="#1F2937"
                        android:textSize="@dimen/font_16"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/dp_12" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_52"
                        android:background="#F9FAFB"
                        android:padding="@dimen/dp_1">

                        <EditText
                            android:id="@+id/et_meeting_title"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="@string/hint_meeting_subject_sample"
                            android:textSize="@dimen/font_15"
                            android:textColor="#1F2937"
                            android:paddingStart="@dimen/dp_16"
                            android:paddingEnd="@dimen/dp_48"
                            android:maxLines="1"
                            android:inputType="text" />

                        <ImageView
                            android:id="@+id/iv_edit_title"
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@android:drawable/ic_menu_edit"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                    </RelativeLayout>

                </LinearLayout>

                <!-- Language Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:padding="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_32"
                    android:elevation="@dimen/dp_2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_voice_recognition"
                        android:textColor="#1F2937"
                        android:textSize="@dimen/font_16"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/dp_12" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_52"
                        android:background="#F9FAFB"
                        android:padding="@dimen/dp_1">

                        <Spinner
                            android:id="@+id/spinner_language"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:layout_centerVertical="true"
                            android:paddingStart="@dimen/dp_16"
                            android:paddingEnd="@dimen/dp_16" />

                        <ImageView
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/dp_16"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="#6B7280" />

                    </RelativeLayout>

                </LinearLayout>

                <!-- AI Features Preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:padding="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:elevation="@dimen/dp_2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_ai_features"
                        android:textColor="#1F2937"
                        android:textSize="@dimen/font_16"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/dp_16" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/dp_12">

                            <View
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:background="#EFF6FF"
                                android:layout_marginBottom="@dimen/dp_8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/title_realtime_transcription"
                                android:textColor="#6B7280"
                                android:textSize="@dimen/font_12" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/dp_12">

                            <View
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:background="#EFF6FF"
                                android:layout_marginBottom="@dimen/dp_8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/title_smart_summary"
                                android:textColor="#6B7280"
                                android:textSize="@dimen/font_12" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/dp_12">

                            <View
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:background="#EFF6FF"
                                android:layout_marginBottom="@dimen/dp_8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/title_key_points"
                                android:textColor="#6B7280"
                                android:textSize="@dimen/font_12" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Recording Status Layout -->
        <include
            android:id="@+id/layout_recording_status"
            layout="@layout/layout_recording_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_20"
        android:background="@color/white"
        android:elevation="@dimen/dp_4">

        <LinearLayout
            android:id="@+id/layout_start_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:background="#3B82F6"
            android:gravity="center"
            android:orientation="horizontal"
            android:elevation="@dimen/dp_2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start_meeting"
                android:textColor="@color/white"
                android:textSize="@dimen/font_18"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/dp_8" />

            <View
                android:layout_width="@dimen/dp_4"
                android:layout_height="@dimen/dp_4"
                android:background="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_stop_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:background="#EF4444"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            android:elevation="@dimen/dp_2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_end_meeting"
                android:textColor="@color/white"
                android:textSize="@dimen/font_18"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>