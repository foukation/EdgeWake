<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/share_longpic_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_alignParentTop="true"
        android:gravity="center">

        <ImageView
           android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:padding="@dimen/dp_4"
            android:src="@mipmap/app_icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_lingxi"
            android:textSize="@dimen/font_21"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/share_longpic_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_81"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="#E0E0E0"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_80">

            <ImageView
                android:layout_width="@dimen/dp_76"
                android:layout_height="@dimen/dp_74"
                android:src="@mipmap/share_bottom_icon"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginLeft="@dimen/dp_6"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_lingxi_agent"
                android:textColor="#000000"
                android:textSize="@dimen/dp_14"
                android:layout_marginTop="@dimen/dp_22"
                android:layout_marginLeft="@dimen/dp_72"
                android:layout_alignParentLeft="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_ai_disclaimer_full"
                android:textColor="#999999"
                android:textSize="@dimen/font_12"
                android:layout_marginTop="@dimen/dp_42"
                android:layout_marginLeft="@dimen/dp_72"
                android:layout_alignParentLeft="true"/>

            <ImageView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:background="#FF0000"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginRight="@dimen/dp_24"
                android:layout_alignParentRight="true"/>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>