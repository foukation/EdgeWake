<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Main slide viewer -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/slide_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Controls overlay -->
    <LinearLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/dp_16"
            android:background="@drawable/gradient_black_transparent">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:tint="@android:color/white"
                android:contentDescription="返回" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/slide_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/label_count_1_7"
                android:textColor="@android:color/white"
                android:textSize="@dimen/font_16"
                android:background="@drawable/bg_rounded_8dp"
                android:backgroundTint="#80000000"
                android:padding="@dimen/dp_8" />

        </LinearLayout>

        <!-- Spacer to push bottom controls down -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom controls (if needed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/dp_16"
            android:background="@drawable/gradient_black_transparent"
            android:gravity="center"
            android:visibility="gone">

            <!-- Could add additional controls here like zoom buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_double_tap_zoom"
                android:textColor="@android:color/white"
                android:textSize="@dimen/font_12"
                android:alpha="0.7" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>