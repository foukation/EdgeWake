<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- 输入框容器 -->
    <LinearLayout
        android:id="@+id/ll_bottom_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_4"
        android:visibility="visible">

        <!-- 主输入区域（文字模式） -->
        <LinearLayout
            android:id="@+id/ll_edit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxHeight="@dimen/dp_192"
            android:minHeight="@dimen/dp_52"
            android:paddingEnd="@dimen/dp_4"
            android:visibility="visible">

            <!-- 输入框 -->
            <EditText
                android:id="@+id/ed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_52"
                android:maxHeight="@dimen/dp_180"
                android:background="@null"
                android:hint="@string/hint_send_message"
                android:textColorHint="#B2B2B2"
                android:textColor="@color/text_black"
                android:textSize="@dimen/font_16"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:paddingTop="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:paddingLeft="@dimen/dp_16"
                android:overScrollMode="always" />
        </LinearLayout>

        <!-- Logo图标（语音模式） -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:src="@drawable/ic_app_logo"
            android:visibility="gone" />

        <!-- 按住说话文本（语音模式） -->
        <TextView
            android:id="@+id/tv_press"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/dp_52"
            android:text="@string/btn_hold_to_speak"
            android:textSize="@dimen/font_16"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

        <!-- 操作按钮区域 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 语音按钮 -->
            <ImageView
                android:id="@+id/iv_voice"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:scaleType="centerCrop"
                android:src="@drawable/home_voice"
                android:layout_marginLeft="@dimen/dp_16" />

            <!-- 键盘按钮（语音模式时显示） -->
            <ImageView
                android:id="@+id/iv_keyboard"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginStart="@dimen/spacing_medium"
                android:background="@drawable/home_keyboard"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 发送按钮 -->
<!--            <ImageView-->
<!--                android:id="@+id/iv_send"-->
<!--                android:layout_width="@dimen/dp_40"-->
<!--                android:layout_height="@dimen/dp_40"-->
<!--                android:layout_marginStart="@dimen/dp_4"-->
<!--                android:background="@drawable/home_send"-->
<!--                android:scaleType="centerCrop"-->
<!--                android:visibility="gone" />-->

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_expand"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:minHeight="@dimen/dp_52"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_edit_open"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:scaleType="centerCrop"
                android:src="@drawable/chat_edit_open"
                android:visibility="gone"
                />
            <LinearLayout
                android:id="@+id/iv_edit_open_expand"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone"
                />

            <ImageView
                android:id="@+id/iv_send"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:scaleType="centerCrop"
                android:src="@drawable/home_send"
                android:visibility="gone"
                />

        </LinearLayout>
    </LinearLayout>

    <!-- 语音波形显示区域 -->
    <LinearLayout
        android:id="@+id/ll_bottom_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        
        <!-- 提示文本 -->
        <TextView
            android:id="@+id/tv_voice_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/btn_release_send_swipe_cancel"
            android:textSize="@dimen/font_12"
            android:textColor="#7F7F7F"
            android:textStyle="bold" />
        
        <!-- 语音波形容器 -->
        <RelativeLayout
            android:id="@+id/rl_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@drawable/bg_voice_blue_r20"
            android:minHeight="@dimen/dp_60"
            android:padding="@dimen/spacing_medium">

            <!-- 语音波形 -->
            <ImageView
                android:id="@+id/iv_bottom_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@mipmap/voice_wave"
                android:scaleType="centerCrop" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
