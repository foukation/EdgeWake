<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_close"
            android:tint="#333333"
            android:scaleType="centerInside"
            android:scaleX="1"
            android:scaleY="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_feedback"
            android:textColor="#333333"
            android:textSize="@dimen/font_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_history"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:gravity="center"
            android:text="@string/title_feedback_history"
            android:textColor="#333333"
            android:textSize="@dimen/font_16"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_20">

            <!-- 联系方式输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/et_contact"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:background="@drawable/bg_edit_text_border"
                    android:hint="@string/hint_leave_contact_info"
                    android:textColorHint="#B2B2B2"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_15"
                    android:textStyle="normal"
                    android:lineSpacingMultiplier="1.0"
                    android:maxLines="1"
                    android:inputType="textEmailAddress"
                    android:padding="@dimen/dp_12" />

            </LinearLayout>

            <!-- 反馈内容输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_320"
                    android:layout_gravity="center_horizontal">

                    <EditText
                        android:id="@+id/et_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_edit_text_border"
                        android:padding="@dimen/dp_12"
                        android:hint="@string/hint_describe_issue"
                        android:textColorHint="#B2B2B2"
                        android:textColor="#1E1E1E"
                        android:textSize="@dimen/font_15"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:maxLength="100" />

                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="@dimen/dp_12"
                        android:text="@string/label_count_0_100"
                        android:textColor="#CCCCCC"
                        android:textSize="@dimen/font_12" />

                </FrameLayout>

            </LinearLayout>

            <!-- 图片上传区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:id="@+id/fl_add_image"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/bg_image_add">

                    <ImageView
                       android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        android:tint="#CCCCCC" />

                    <TextView
                        android:id="@+id/tv_image_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="@dimen/dp_8"
                        android:text="@string/label_count_0_4"
                        android:textColor="#999999"
                        android:textSize="@dimen/font_12" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 提交按钮 -->
    <Button
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_margin="@dimen/dp_20"
        android:text="@string/btn_submit"
        android:textColor="@android:color/white"
        android:textSize="@dimen/font_16"
        android:background="@drawable/bg_button_primary"
        android:enabled="true" />

</LinearLayout>