<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_14"
    android:layout_marginRight="@dimen/dp_16"
    android:orientation="horizontal">

    <include layout="@layout/lingxi_base_radio_layout"
        android:id="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:id="@+id/ll_content"
        app:layout_constraintStart_toEndOf="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="@+id/radio_layout"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_received"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlandItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/dp_12"
            android:paddingRight="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_10" />

        <TextView
            android:id="@+id/id_tv_more"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_12"
            android:background="@drawable/shape_r10_cf5f5f7"
            android:gravity="center"
            android:text="@string/label_more_arrow"
            android:textColor="@color/color_38000000"
            android:textSize="@dimen/font_12" />

        <TextView
            android:id="@+id/id_tv_card_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="@string/txt_plant_card_bottom_toast"
            android:textColor="@color/color_61000000"
            android:textSize="@dimen/font_10" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_12"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r100_cf5f5f7"
                android:paddingLeft="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingRight="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="@string/txt_content_form_ai"
                android:textColor="@color/color_61000000"
                android:textSize="@dimen/font_10" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/shape_r100_cf5f5f7"
                android:paddingLeft="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingRight="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:src="@drawable/icon_cai" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginRight="@dimen/dp_45"
                android:background="@drawable/shape_r100_cf5f5f7"
                android:paddingLeft="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingRight="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:src="@drawable/icon_zan" />
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/vw_empty"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/ll_content"
        app:layout_constraintBottom_toBottomOf="@+id/ll_content"
        app:layout_constraintStart_toStartOf="@+id/ll_content"
        app:layout_constraintEnd_toEndOf="@+id/ll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>