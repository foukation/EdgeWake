<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_14"
    android:layout_marginRight="@dimen/dp_16"
    android:orientation="horizontal">


    <include layout="@layout/lingxi_base_radio_layout"
        android:id="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:id="@+id/id_ll_plan_loading"
        app:layout_constraintStart_toEndOf="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="@+id/radio_layout"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_plan_load"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_35"
        android:visibility="gone">

        <TextView
            android:id="@+id/id_tv_plan_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dp_10"
            android:gravity="center"
            android:text="@string/txt_plan_loading"
            android:textColor="@color/black"
            android:textSize="@dimen/dp_14"
            app:drawableTopCompat="@drawable/icon_plan_loading" />

        <ProgressBar
            android:id="@+id/id_pgb_plan"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_7"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_10"
            android:progressDrawable="@drawable/progress_bar_color" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/id_ll_plan_load_fail"
        app:layout_constraintStart_toEndOf="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="@+id/radio_layout"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_plan_load"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/dp_12"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_150"
            android:background="@drawable/load_error" />

        <ImageView
            android:layout_width="@dimen/dp_140"
            android:layout_height="@dimen/dp_80"
            android:background="@drawable/bg_plan_load_fail_01" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/id_ll_plan_card"
        app:layout_constraintStart_toEndOf="@+id/radio_layout"
        app:layout_constraintTop_toTopOf="@+id/radio_layout"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_received"
        android:orientation="vertical"
        android:padding="@dimen/dp_12"
        android:visibility="visible">

        <ImageView
            android:id="@+id/id_iv_plan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_160" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">

            <TextView
                android:id="@+id/id_tv_plan_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textColor="#333333"
                android:textSize="@dimen/font_18"
                android:textStyle="bold"
                tools:text="上海到北京" />

            <TextView
                android:id="@+id/id_tv_plan_more"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_24"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/shape_r100_c1587ff"
                android:gravity="center"
                android:text="@string/btn_click_to_view"
                android:textColor="@color/color_1587ff"
                android:textSize="@dimen/font_12" />
        </FrameLayout>

        <TextView
            android:id="@+id/id_tv_plan_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:drawablePadding="@dimen/dp_4"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="@dimen/font_14"
            app:drawableLeftCompat="@drawable/icon_time"
            tools:text="2023/9/9" />

        <TextView
            android:id="@+id/id_tv_plan_to_where"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:drawablePadding="@dimen/dp_4"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="@dimen/font_14"
            app:drawableLeftCompat="@drawable/icon_location_plan"
            tools:text="2023/9/9" />

        <TextView
            android:id="@+id/id_tv_plan_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_4"
            android:drawablePadding="@dimen/dp_4"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="@dimen/font_14"
            app:drawableLeftCompat="@drawable/icon_location"
            tools:text="2023/9/9" />


    </LinearLayout>

    <View
        android:id="@+id/vw_empty"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>