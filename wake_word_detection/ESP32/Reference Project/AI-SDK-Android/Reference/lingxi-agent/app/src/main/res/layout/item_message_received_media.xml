<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/dp_280"
    android:layout_height="@dimen/dp_64"
    android:layout_marginTop="@dimen/dp_16"
    android:layout_marginBottom="@dimen/dp_16"
    android:layout_marginStart="@dimen/dp_20"
    android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_message_received_music">
            <ImageView
                android:id="@+id/iv_music"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_10"
                android:contentDescription="TODO"
                android:src="@drawable/icon_audio_mini_player" />

            <ImageView
                android:id="@+id/play_iv"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_16"
                android:contentDescription="TODO"
                android:src="@drawable/audio_mini_player_play" />

            <TextView
                android:id="@+id/album_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_10"
                android:layout_toStartOf="@id/play_iv"
                android:layout_toEndOf="@+id/iv_music"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_1E1E1E"
                android:textSize="@dimen/font_16"
                tools:text="" />

        </RelativeLayout>
</LinearLayout>