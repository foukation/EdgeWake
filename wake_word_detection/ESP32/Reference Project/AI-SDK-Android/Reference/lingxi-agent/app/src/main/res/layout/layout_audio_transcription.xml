<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Step Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/dp_24"
        android:gravity="center">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <TextView
               android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:background="@drawable/circle_background"
                android:gravity="center"
                android:text="@string/label_one"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_16"
                android:id="@+id/step1_circle" />

            <TextView
                android:id="@+id/tv_step1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/step1_circle"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/btn_select_language"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_12" />

        </RelativeLayout>

        <View
            android:id="@+id/step_indicator1"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_weight="1"
            android:background="@color/divider"
            android:layout_marginTop="@dimen/dp_neg_24" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <TextView
               android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:background="@drawable/circle_background_inactive"
                android:gravity="center"
                android:text="@string/label_two"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/font_16"
                android:id="@+id/step2_circle" />

            <TextView
                android:id="@+id/tv_step2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/step2_circle"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/btn_upload_audio_video"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/font_12" />

        </RelativeLayout>

        <View
            android:id="@+id/step_indicator2"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_weight="1"
            android:background="@color/divider"
            android:layout_marginTop="@dimen/dp_neg_24" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
               android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/text_hint"
                android:id="@+id/step3_circle" />

            <TextView
                android:id="@+id/tv_step3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/step3_circle"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/btn_submit_transcription"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/font_12" />

        </RelativeLayout>

    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: Language Selection -->
        <ScrollView
            android:id="@+id/layout_select_language"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_select_audio_lang_required"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_16"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/dp_16" />

                <RadioGroup
                    android:id="@+id/rg_language_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Chinese Mandarin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@android:color/white"
                        android:padding="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_12">

                        <RadioButton
                            android:id="@+id/rb_chinese_mandarin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/dp_12">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_mandarin"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_16"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_for_mainland_china"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_14"
                                android:layout_marginTop="@dimen/dp_4" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_mainland_dialect"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/font_14"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                    <!-- Other language options follow similar pattern -->

                </RadioGroup>

            </LinearLayout>

        </ScrollView>

        <!-- Step 2: Upload File -->
        <LinearLayout
            android:id="@+id/layout_upload_file"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/dp_16"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/content_upload_av_file"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_16"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/dp_16" />

            <LinearLayout
                android:id="@+id/btn_upload_file"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_120"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:gravity="center"
                android:layout_marginBottom="@dimen/dp_16">

                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@android:drawable/ic_menu_upload"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/content_click_upload_av"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_14"
                    android:layout_marginTop="@dimen/dp_8" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/content_supported_av_formats"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/font_12" />

        </LinearLayout>

        <!-- Step 3: Transcription Complete -->
        <LinearLayout
            android:id="@+id/layout_transcription_complete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/dp_16"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_transcription_submitted"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_18"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/dp_16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_transcription_notification"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_14"
                android:layout_marginTop="@dimen/dp_8" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_16"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/btn_transcription"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:background="#333333"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_transcription_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start_transcription"
                android:textColor="@color/white"
                android:textSize="@dimen/font_16"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>