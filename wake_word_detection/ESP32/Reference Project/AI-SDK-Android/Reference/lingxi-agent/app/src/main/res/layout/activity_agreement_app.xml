<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <!-- 标题栏和内容区（原有内容） -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_centerVertical="true"
                android:padding="@dimen/dp_14"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:fontWeight="500"
                android:text="@string/title_service_agreement"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/font_16"
                android:textStyle="normal" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <!-- 功能选项块紧随Logo部分，无需额外marginTop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/about_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:background="@drawable/bg_block_rounded_16_gray"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16">
                    <LinearLayout
                        android:id="@+id/rl_agreement_pri1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:fontWeight="400"
                            android:text="@string/title_privacy_policy"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/font_16"
                            android:textStyle="normal" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp_1"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="#CCCCCC" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:background="#EDEDED" />
                    <!-- 版本更新块 -->
                    <LinearLayout
                        android:id="@+id/rl_agreement_pri2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:fontWeight="400"
                            android:text="@string/label_privacy_policy_summary"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/font_16"
                            android:textStyle="normal" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp_1"
                            android:layout_weight="1" />
                        <ImageView
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="#CCCCCC" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:background="#EDEDED"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/rl_agreement_user"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:fontWeight="400"
                            android:text="@string/title_user_agreement"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/font_16"
                            android:textStyle="normal" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp_6"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="#CCCCCC" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:background="#EDEDED" />

                    <LinearLayout
                        android:id="@+id/rl_agreement_sharelist"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:fontWeight="400"
                            android:text="@string/label_third_party_sharing"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/font_16"
                            android:textStyle="normal" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp_6"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="#CCCCCC" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:background="#EDEDED"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/rl_agreement_userlist"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:fontWeight="400"
                            android:text="@string/label_personal_info_collection"
                            android:textColor="#1E1E1E"
                            android:textSize="@dimen/font_16"
                            android:textStyle="normal" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp_6"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="#CCCCCC" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- 绝对定位底部版权信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/dp_50"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_2"
            android:fontFamily="sans-serif"
            android:fontWeight="400"
            android:gravity="center"
            android:letterSpacing="0"
            android:lineHeight="@dimen/dp_18"
            android:text="@string/label_icp_filing"
            android:textColor="#B2B2B2"
            android:textSize="@dimen/font_10"
            android:textStyle="normal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="sans-serif"
            android:fontWeight="400"
            android:gravity="center"
            android:letterSpacing="0"
            android:lineHeight="@dimen/dp_18"
            android:text="@string/label_copyright"
            android:textColor="#B2B2B2"
            android:textSize="@dimen/font_10"
            android:textStyle="normal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:fontWeight="400"
            android:gravity="center"
            android:letterSpacing="0"
            android:lineHeight="@dimen/dp_18"
            android:text="@string/label_cm_copyright"
            android:textColor="#B2B2B2"
            android:textSize="@dimen/font_10"
            android:textStyle="normal" />
    </LinearLayout>
</FrameLayout>