<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_top_radius_16"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_16">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_12"
            android:text="@string/btn_select_image"
            android:textColor="@color/text_black"
            android:textSize="@dimen/font_16"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btn_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_ai_pick_camera_btn"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_camera_icon"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:background="@drawable/ai_file_pick_camera"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/btn_capture"
                android:textColor="@android:color/white"
                android:textSize="@dimen/font_16"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/bg_ai_pick_album_btn"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_album_icon"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:background="@drawable/ai_file_pick_album" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/title_system_album"
                android:textColor="@android:color/white"
                android:textSize="@dimen/font_16"
                android:textStyle="bold" />
        </LinearLayout>

<!--        <TextView-->
<!--            android:id="@+id/btn_cancel"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="@dimen/dp_48"-->
<!--            android:layout_marginTop="@dimen/dp_12"-->
<!--            android:gravity="center"-->
<!--            android:text="@string/btn_cancel"-->
<!--            android:textColor="@color/text_999"-->
<!--            android:textSize="@dimen/font_14" />-->

    </LinearLayout>
</RelativeLayout>
