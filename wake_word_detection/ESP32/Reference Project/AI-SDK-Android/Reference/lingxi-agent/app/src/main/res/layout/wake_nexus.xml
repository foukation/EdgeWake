<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.fxzs.lingxiagent.view.widget.GradientGlowCardView
        android:id="@+id/ll_bottom_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.fxzs.lingxiagent.lingxi.float_manager.GradientBorderLayout
        android:id="@+id/voice_gbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_4"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.fxzs.lingxiagent.view.common.VoiceButton
            android:id="@+id/btn_wx_voice"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:layout_gravity="bottom|center_horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.fxzs.lingxiagent.lingxi.float_manager.AudioWaveGlowView
            android:id="@+id/btn_wx_voice2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:layout_gravity="bottom|center_horizontal"
            app:layout_constraintBottom_toBottomOf="parent" />

    </com.fxzs.lingxiagent.lingxi.float_manager.GradientBorderLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
