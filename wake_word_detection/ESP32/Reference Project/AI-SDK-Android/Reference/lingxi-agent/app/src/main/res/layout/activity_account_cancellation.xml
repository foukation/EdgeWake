<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <!-- 标题栏 -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/btn_delete_account"
            android:textColor="#333333"
            android:textSize="@dimen/font_18"
            android:textStyle="bold" />

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:paddingBottom="@dimen/dp_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <!-- 注销账号图标和文字 -->
            <LinearLayout
                android:id="@+id/layout_icon"
                android:layout_width="@dimen/dp_100"
                android:layout_height="wrap_content"
                android:layout_below="@id/toolbar"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/dp_20"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="@dimen/dp_80"
                    android:src="@drawable/ic_account_delete" />

                <TextView
                    android:id="@+id/tv_mobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/btn_delete_account"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_14"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="-0.015"
                    android:lineSpacingMultiplier="1.0" />

            </LinearLayout>

            <!-- 协议内容 -->
            <LinearLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_34"
                android:paddingHorizontal="@dimen/dp_24"
                android:paddingVertical="@dimen/dp_10"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/content_delete_account_notice"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_13"
                    android:textStyle="normal"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/content_delete_account_clause_1"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_15"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/content_delete_account_data_1"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_13"
                    android:textStyle="normal"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/content_delete_account_clause_2"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_15"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/content_delete_account_data_2"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_13"
                    android:textStyle="normal"
                    android:lineSpacingMultiplier="1.0" />

            </LinearLayout>

            <!-- 验证码输入框 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginHorizontal="@dimen/dp_36"
                android:layout_marginTop="@dimen/dp_20">

                <EditText
                    android:id="@+id/et_verification"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/hint_input_verify_code"
                    android:inputType="number"
                    android:textSize="@dimen/font_14"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_110"
                    android:background="@drawable/bg_edittext_round_white"
                    android:textColor="#1E1E1E"
                    style="@style/EditTextMaxLength"
                    android:textColorHint="#B2B2B2" />

                <TextView
                    android:id="@+id/tv_get_code"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:text="@string/btn_get_verify_code"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_14"
                    android:gravity="center"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:background="#F7F7F7" />
            </FrameLayout>

            <!-- 注销账号按钮 -->
            <LinearLayout
                android:id="@+id/btn_cancel_account_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:background="@drawable/bg_rounded_12dp_red">

                <TextView
                    android:id="@+id/btn_cancel_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_delete_account"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/font_16" />

            </LinearLayout>

            <!-- 协议同意 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_23"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cb_agreement"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ic_checkbox_unchecked" />

                <TextView
                    android:id="@+id/tv_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:text="@string/content_agree_delete_account_agreement"
                    android:textColor="#1E1E1E"
                    android:textSize="@dimen/font_13"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="-0.017"
                    android:lineSpacingMultiplier="1.0" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</LinearLayout>
