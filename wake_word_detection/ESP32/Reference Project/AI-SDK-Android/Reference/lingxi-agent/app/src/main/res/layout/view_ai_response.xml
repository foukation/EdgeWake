<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- AI Response Card -->
    <LinearLayout
        android:id="@+id/ll_ai_response_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ai_response_card"
        android:orientation="vertical"
        android:padding="@dimen/dp_16">

        <!-- Thinking Process Section -->
        <LinearLayout
            android:id="@+id/ll_thinking_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_thinking_section"
            android:layout_marginBottom="@dimen/dp_12"
            android:visibility="gone">
            
            <!-- Thinking Process Header -->
            <LinearLayout
                android:id="@+id/ll_thinking_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/dp_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/ic_thinking"
                    android:tint="#4690FF"/>

                <TextView
                    android:id="@+id/tv_thinking_process"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/label_thinking_process_3s"
                    android:textSize="@dimen/font_14"
                    android:textColor="#333333"/>

                <ImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="#666666"/>

            </LinearLayout>
            
            <!-- Thinking Process Text -->
            <TextView
                android:id="@+id/tv_thinking_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_12"
                android:text=""
                android:textSize="@dimen/font_14"
                android:textColor="#666666"
                android:lineSpacingMultiplier="1.5"
                android:visibility="gone"/>
                
        </LinearLayout>

        <!-- Title (Optional) -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/tab_meeting_content"
            android:textSize="@dimen/font_16"
            android:textColor="#1E1E1E"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- Content -->
        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text=""
            android:textSize="@dimen/font_16"
            android:textColor="#1E1E1E"
            android:lineSpacingMultiplier="1.4"/>

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0.5"
            android:layout_marginTop="@dimen/dp_12"
            android:background="#E0E0E0"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="horizontal">

            <!-- Left Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_copy"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_copy"
                    android:scaleType="centerInside"
                    android:visibility="gone"/>

                <ImageButton
                    android:id="@+id/btn_speak"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:layout_marginStart="@dimen/dp_16"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_speak"
                    android:scaleType="centerInside"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_28"
                android:background="@drawable/bg_refresh_button"
                android:src="@drawable/ic_refresh"
                android:scaleType="centerInside"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>