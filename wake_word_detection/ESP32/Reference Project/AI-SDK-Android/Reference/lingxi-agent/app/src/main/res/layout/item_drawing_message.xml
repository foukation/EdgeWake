<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16"
    android:paddingTop="@dimen/dp_8"
    android:layout_marginBottom="@dimen/dp_14"
    android:paddingBottom="@dimen/dp_8">
    
    <!-- 用户消息（描述） -->
    <TextView
        android:id="@+id/tv_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:padding="@dimen/dp_12"
        android:background="@drawable/bg_message_user"
        android:textColor="#333333"
        android:textSize="@dimen/font_15"
        android:visibility="gone" />
    
    <!-- AI回复容器 -->
    <LinearLayout
        android:id="@+id/ll_ai_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        
        <!-- AI文字回复 -->
        <TextView
            android:id="@+id/tv_ai_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_8"
            android:padding="@dimen/dp_12"
            android:background="@drawable/bg_message_ai"
            android:textColor="#333333"
            android:textSize="@dimen/font_15"
            android:visibility="gone" />
        
        <!-- 生成进度容器 -->
        <LinearLayout
            android:id="@+id/ll_progress"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_320"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_gradient_purple_pink"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/dp_8"
            android:paddingTop="@dimen/dp_30">

            <FrameLayout
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_40"
                android:layout_marginBottom="@dimen/dp_16">
                
                <!-- 大星星 -->
                <ImageView
                    android:id="@+id/iv_sparkle_big"
                   android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:layout_gravity="bottom|start"
                    android:src="@drawable/ic_star_white" />
                
                <!-- 小星星 -->
                <ImageView
                    android:id="@+id/iv_sparkle_small"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_gravity="top|end"
                    android:src="@drawable/ic_star_white" />
                
            </FrameLayout>

            <TextView
                android:id="@+id/tv_progress_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_zero_percent"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/dp_32"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/dp_150"
                android:layout_height="@dimen/dp_4"
                android:layout_marginTop="@dimen/dp_12"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_white"
                android:background="#33FFFFFF" />

        </LinearLayout>
        
        <!-- 图片结果容器 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_image"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_320"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="0dp"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/dp_8">
            
            <ImageView
                android:id="@+id/iv_generated_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true" />
                
        </androidx.cardview.widget.CardView>
        
        <!-- 操作按钮 -->
        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            
            <ImageButton
                android:id="@+id/btn_download"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_download"
                android:background="@drawable/bg_circle_selector"
                android:layout_marginEnd="@dimen/dp_12" />
                
            <TextView
                android:id="@+id/tv_continue_edit"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                android:gravity="center"
                android:text="@string/btn_continue_edit"
                android:textColor="#666666"
                android:textSize="@dimen/font_14"
                android:background="@drawable/bg_button_outline" />
                
        </LinearLayout>
        
    </LinearLayout>
    
</LinearLayout>