<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 外层阴影 (更深的颜色) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#12606F8B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 中层阴影 -->
            <item 
                android:top="1dp"
                android:bottom="3dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#10606F8B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 主体背景 (稍微灰一点的白色) -->
            <item 
                android:top="2dp"
                android:bottom="4dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F8F8F8" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <layer-list>
            <!-- 外层阴影 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0F606F8B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 中层阴影 -->
            <item 
                android:top="1dp"
                android:bottom="3dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#0C606F8B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 主体背景 -->
            <item 
                android:top="2dp"
                android:bottom="4dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="#E0E0E0" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <layer-list>
            <!-- 外层阴影 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0A606F8B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 中层阴影 -->
            <item 
                android:top="1dp"
                android:bottom="3dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#08606F8B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 主体背景 -->
            <item 
                android:top="2dp"
                android:bottom="4dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>