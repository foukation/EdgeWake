<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- 顶部导航栏 -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:paddingHorizontal="@dimen/dp_16"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"

            android:contentDescription="返回" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_40"
            android:src="@drawable/ic_close"

            android:contentDescription="关闭"
            android:visibility="gone"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/btn_select_template"
            android:textColor="#1E1E1E"
            android:textSize="@dimen/font_17"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- 筛选栏 -->
    <LinearLayout
        android:id="@+id/filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_12"
        android:background="#FFFFFF">

        <!-- 颜色筛选 -->
        <LinearLayout
            android:id="@+id/color_filter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/dp_32"
            android:layout_marginEnd="@dimen/dp_15"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_filter_option"
            android:paddingHorizontal="@dimen/dp_12"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/color_filter_content"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_color_colon"
                        android:textColor="#1E1E1E"
                        android:textSize="@dimen/font_14"
                        android:layout_marginEnd="@dimen/dp_8"/>

                <View
                    android:id="@+id/color_indicator_random"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:background="@drawable/bg_color_indicator"
                    android:layout_marginEnd="@dimen/dp_8" />
                <View
                    android:id="@+id/color_indicator"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:background="@drawable/bg_color_indicator"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:visibility="gone"/>
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_arrow_drop_down"
                android:tint="#666666" />

        </LinearLayout>

        <!-- 风格筛选 -->
        <LinearLayout
            android:id="@+id/style_filter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/dp_32"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_filter_option"
            android:paddingHorizontal="@dimen/dp_12"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_style_colon"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/font_14"
                android:layout_marginEnd="@dimen/dp_8" />

            <TextView
                android:id="@+id/style_filter_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_recommended"
                android:textColor="#1E1E1E"
                android:textSize="@dimen/font_14"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_arrow_drop_down"
                android:tint="#666666" />

        </LinearLayout>

    </LinearLayout>

    <!-- 风格选择下拉菜单 -->
    <LinearLayout
        android:id="@+id/style_dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:visibility="gone"
        android:elevation="@dimen/dp_4">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="#E0E0E0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:id="@+id/style_recommended"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:text="@string/title_recommended"
                android:textSize="@dimen/font_15"
                android:textColor="#1E1E1E"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/style_business"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:text="@string/title_simple_business"
                android:textSize="@dimen/font_15"
                android:textColor="#1E1E1E"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/style_cartoon"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:text="@string/title_cartoon_illustration"
                android:textSize="@dimen/font_15"
                android:textColor="#1E1E1E"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

<!--            <TextView-->
