<!--                android:focusable="true" />-->

            <TextView
                android:id="@+id/style_chinese"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:text="@string/title_chinese_style"
                android:textSize="@dimen/font_15"
                android:textColor="#1E1E1E"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/style_fresh"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:text="@string/title_watercolor_fresh"
                android:textSize="@dimen/font_15"
                android:textColor="#1E1E1E"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

<!--            <TextView-->
<!--                android:id="@+id/style_government"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="@dimen/dp_44"-->
<!--                android:text="@string/title_party_government"-->
<!--                android:textSize="@dimen/font_15"-->
<!--                android:textColor="#1E1E1E"-->
<!--                android:gravity="center_vertical"-->
<!--                android:background="?android:attr/selectableItemBackground"-->
