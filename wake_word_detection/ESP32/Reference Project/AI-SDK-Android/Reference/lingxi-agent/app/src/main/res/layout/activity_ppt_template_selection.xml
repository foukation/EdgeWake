    <!-- 底部操作栏 -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:padding="@dimen/dp_16"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/refresh_templates_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_15"
            android:gravity="center"
            android:background="@drawable/bg_button_outline_rounded" >

            <ImageView
                android:id="@+id/iv_sub_add"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:scaleType="fitXY"
                android:background="@drawable/ppt_refresh"
                android:visibility="visible"/>
            <TextView
                android:id="@+id/tag2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_switch_template"
                android:textSize="@dimen/font_14"
                android:textColor="@color/figma_text_primary"
                android:layout_marginLeft="@dimen/dp_8"/>
        </LinearLayout>

        <Button
            android:id="@+id/generate_ppt_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/dp_40"
            android:text="@string/btn_generate_ppt"
            android:textSize="@dimen/font_16"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_blue_new"
            android:enabled="false"
            android:alpha="0.5" />

    </LinearLayout>

