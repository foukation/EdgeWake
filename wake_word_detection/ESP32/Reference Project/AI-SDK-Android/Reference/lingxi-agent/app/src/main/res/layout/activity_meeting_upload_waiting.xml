<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background_color"
    android:padding="@dimen/dp_32">

    <!-- 文件图标 -->
    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:src="@drawable/ic_audio_file"
        android:layout_marginBottom="@dimen/dp_32"
        android:contentDescription="音频文件图标" />

    <!-- 状态文本 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_uploading"
        android:textSize="@dimen/font_20"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/dp_16" />

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="@dimen/dp_200"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8"
        android:indeterminate="true"
        android:progressTint="@color/primary_color" />

    <!-- 进度百分比 -->
    <TextView
        android:id="@+id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_zero_percent"
        android:textSize="@dimen/font_14"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="@dimen/dp_24"
        android:visibility="gone" />

    <!-- 提示信息 -->
    <TextView
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/msg_uploading_recording"
        android:textSize="@dimen/font_14"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2" />

</LinearLayout>