<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 顶部导航栏 -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:paddingHorizontal="@dimen/dp_16">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="centerInside"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/btn_register"
            android:textSize="@dimen/font_16"
            android:textColor="#999999"/>

    </RelativeLayout>

    <!-- 内容区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_header"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/dp_24">

        <!-- 成功提示卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            android:background="@drawable/rounded_card_light_green"
            android:orientation="horizontal"
            android:padding="@dimen/dp_16"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@android:drawable/checkbox_on_background"
                android:tint="#4CAF50"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:text="@string/hint_new_password_relogin"
                android:textSize="@dimen/font_16"
                android:textColor="#4CAF50"/>

        </LinearLayout>

        <!-- 验证码和账号密码标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_60"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_verify_code"
                android:textSize="@dimen/font_24"
                android:textColor="#999999"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:text="@string/label_account_password"
                android:textSize="@dimen/font_24"
                android:textColor="@android:color/black"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- 下划线 -->
        <View
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_3"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_140"
            android:background="@android:color/black"/>

        <!-- 提示文字 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/hint_no_account_register"
            android:textSize="@dimen/font_14"
            android:textColor="#999999"/>

        <!-- 手机号输入框（预填充） -->
        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_40"
            android:hint="@string/hint_input_phone_number"
            android:textSize="@dimen/font_16"
            android:enabled="false"
            style="@style/EditTextMaxLength"
            android:textColor="#999999"/>

        <!-- 密码输入框 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_16">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/hint_input_password"
                android:inputType="textPassword"
                android:textSize="@dimen/font_16"
                style="@style/EditTextMaxLength"
                android:paddingEnd="@dimen/dp_48"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/btn_forgot_password_2"
                android:textSize="@dimen/font_14"
                android:textColor="#999999"
                android:paddingHorizontal="@dimen/dp_8"/>

        </RelativeLayout>

        <!-- 登录按钮 -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_40"
            android:background="@drawable/button_rounded_black"
            android:text="@string/btn_login"
            android:textSize="@dimen/font_16"
            android:textColor="@android:color/white"/>

        <!-- 协议同意 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_24"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/cb_agreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>

            <TextView
                android:id="@+id/tv_agreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/content_agree_terms_iya"
                android:textSize="@dimen/font_12"
                android:textColor="#666666"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>