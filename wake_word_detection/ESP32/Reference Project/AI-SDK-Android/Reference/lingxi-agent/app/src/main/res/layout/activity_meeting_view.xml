<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">
    
    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:background="@color/background_primary">
        
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/dp_4" />
        
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_16"
            android:text="@string/title_meeting_details"
            android:textSize="@dimen/font_18"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        
    </LinearLayout>
    
    <!-- Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:orientation="horizontal"
        android:background="@color/white">
        
        <LinearLayout
            android:id="@+id/tab_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/tv_tab_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_meeting_content"
                android:textSize="@dimen/font_14"
                android:textColor="@color/text_primary" />
            
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/tab_summary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/tv_tab_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_meeting_summary"
                android:textSize="@dimen/font_14"
                android:textColor="@color/text_secondary" />
            
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/tab_topic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/tv_tab_topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_meeting_topics"
                android:textSize="@dimen/font_14"
                android:textColor="@color/text_secondary" />
            
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/tab_qa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/tv_tab_qa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_smart_qa"
                android:textSize="@dimen/font_14"
                android:textColor="@color/text_secondary" />
            
        </LinearLayout>
        
    </LinearLayout>
    
    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    
</LinearLayout>