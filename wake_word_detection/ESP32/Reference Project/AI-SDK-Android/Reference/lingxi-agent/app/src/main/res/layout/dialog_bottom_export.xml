<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_dialog_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/title_export_as"
        android:textColor="#000000"
        android:textSize="@dimen/dp_16" />

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_20"
        android:src="@mipmap/ic_close_dialog" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_word"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawableTop="@mipmap/ic_word"
            android:drawablePadding="@dimen/dp_10"
            android:paddingTop="@dimen/dp_22"
            android:layout_marginRight="@dimen/dp_13"
            android:text="@string/label_word_doc"
            android:textSize="@dimen/font_12"
            android:textColor="#000000"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:background="@drawable/dialog_text_bg"/>

        <TextView
            android:id="@+id/tv_pdf"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawableTop="@mipmap/ic_pdf"
            android:drawablePadding="@dimen/dp_10"
            android:paddingTop="@dimen/dp_22"
            android:layout_marginRight="@dimen/dp_13"
            android:text="@string/label_pdf_doc"
            android:textSize="@dimen/font_12"
            android:textColor="#000000"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:background="@drawable/dialog_text_bg"/>

        <TextView
            android:id="@+id/tv_txt"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawableTop="@mipmap/ic_text"
            android:drawablePadding="@dimen/dp_10"
            android:paddingTop="@dimen/dp_22"
            android:text="@string/label_txt_file"
            android:textSize="@dimen/font_12"
            android:textColor="#000000"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:background="@drawable/dialog_text_bg"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_export"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_176"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_40"
        android:text="@string/btn_export"
        android:textSize="@dimen/font_16"
        android:textColor="#FFFFFF"
        android:background="@drawable/dialog_bt_bg"/>

</RelativeLayout>