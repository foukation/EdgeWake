<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_primary" />
            <corners android:radius="@dimen/ppt_corner_radius_medium" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_CCC" />
            <corners android:radius="@dimen/ppt_corner_radius_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ppt_card_background" />
            <corners android:radius="@dimen/ppt_corner_radius_medium" />
            <stroke 
                android:width="1dp" 
                android:color="@color/ppt_divider" />
        </shape>
    </item>
</selector>