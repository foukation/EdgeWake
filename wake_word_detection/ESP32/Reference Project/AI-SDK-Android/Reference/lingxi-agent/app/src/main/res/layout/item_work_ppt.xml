<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:id="@+id/root_view"
    android:gravity="end">


<!--    <androidx.cardview.widget.CardView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_marginBottom="@dimen/dp_10"-->
<!--        app:cardCornerRadius="@dimen/dp_12"-->
<!--        app:cardElevation="@dimen/dp_2">-->

        <LinearLayout
            android:id="@+id/ll_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="@dimen/dp_16"
            android:background="@drawable/bg_white_radius_16"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_5"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/dp_10"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18"
                    android:background="@drawable/ai_work_ppt_icon"
                    android:layout_marginRight="@dimen/dp_8"
                    />
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/label_ppt_of_x"
                    android:textSize="@dimen/font_16"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"
                    android:textColor="@color/figma_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/iv_more"
                   android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/ai_work_more"
                    />
            </LinearLayout>


<!--            <TextView-->
<!--                android:id="@+id/tv_content"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="@string/content_taobao_intro_brief"-->
<!--                android:textSize="@dimen/font_14"-->
<!--                android:fontFamily="sans-serif-medium"-->
<!--                android:textFontWeight="400"-->
<!--                android:textColor="@color/figma_text_primary"-->
<!--                android:layout_marginBottom="@dimen/dp_10"-->
<!--                android:layout_centerHorizontal="true"/>-->
            <ImageView
                android:id="@+id/iv_content"
                android:layout_width="@dimen/dp_180"
                android:layout_height="@dimen/dp_90"
                android:maxWidth="@dimen/dp_180"
                android:maxHeight="@dimen/dp_180"
                android:layout_gravity="start"
                android:layout_marginBottom="@dimen/dp_10"

                />


            <TextView
                android:id="@+id/tv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_date_sample"
                android:textSize="@dimen/font_14"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="400"
                android:textColor="@color/figma_text_secondary"
                android:layout_centerHorizontal="true"/>

        </LinearLayout>
<!--    </androidx.cardview.widget.CardView>-->


</LinearLayout>