# ESP32-S3 PSRAM 配置
# 立创实战派：ESP32-S3-WROOM-1-N16R8 模组，8MB PSRAM（Octal 接口）
# 注意：CONFIG_SPIRAM 是 IDF 5.x 现代符号；旧符号 CONFIG_ESP32S3_SPIRAM_SUPPORT 已废弃
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 允许将 .bss 段变量放入 PSRAM（tensor_arena 等大块内存）
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y